# Build and test output
/dist/
*.test
*.out
*.prof

# Fuzzing corpora that reproduce a failure are not ignored. A crasher
# committed alongside the fix is what stops the same input from coming
# back, and it is the only artefact that proves the fix was tested against
# the thing it fixes.
!testdata/fuzz/

# The CA the integration container generates at first start. It is
# regenerated on every fresh volume and is worthless outside the test
# container, so there is nothing to keep and nothing to leak.
/integration/testdata/

# Editors
.idea/
.vscode/
*.swp
.DS_Store
